# Railway Postgres service se link karo
DATABASE_URL=postgresql://user:pass@host:5432/railway

# 64 hex characters. Banane ke liye:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ise kahin safe likh lo — badla to sab mailbox passwords dobara daalne padenge.
ENCRYPTION_KEY=

# App kholne ka password
APP_PASSWORD=

# Gmail / Google Workspace sending (SMTP ke bina — Railway Hobby pe bhi chalega)
# OAuth client console.cloud.google.com pe banao, phir dono yaha paste karo.
APP_URL=https://mailer.customesolution.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# RUN_WORKER=true
# SCHEDULER_INTERVAL_MS=30000
# IMAP_INTERVAL_MS=300000
# MAX_SENDS_PER_TICK=12
